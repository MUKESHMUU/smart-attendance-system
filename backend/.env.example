PORT=5000
# Long random string. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# Frontend address allowed by CORS (comma-separate several)
CLIENT_URL=http://localhost:5173
# Where the JSON files live. On Azure Linux App Service use /home/data
DATA_DIR=./data
